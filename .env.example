# Optional local configuration
PORT=3000
NODE_ENV=development

# Approved scan root directory (defaults to ./scan-workspace inside the project)
# FILO_SCAN_ROOT=D:/Projects/MyFolderToOrganize

# Bounded scan limit (defaults to 2000)
# FILO_MAX_FILES=2000

# Local AI configuration (Ollama + Gemma)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_TIMEOUT_MS=30000
